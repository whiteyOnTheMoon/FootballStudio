# Copy to .env and generate strong, distinct secret values before Compose start.
# DO NOT commit .env or use empty/example values for a running instance.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=footballstudio
POSTGRES_USER=footballstudio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=0
# Set to 1 only for local loopback HTTP login tests; not for VPS deployment.
DJANGO_LOCAL_HTTP=0
DJANGO_TRUST_PROXY=0
APP_PORT=8000

# Optional: only used by compose.tunnel.yaml (Cloudflare remote-managed tunnel).
# NEVER paste this bearer credential into Git, chat, issues or CI logs.
CLOUDFLARE_TUNNEL_TOKEN=
# Start at 0; enable HSTS only after verifying public HTTPS end-to-end.
DJANGO_HSTS_SECONDS=0

# Reuse an EXISTING Cloudflare Tunnel (no new tunnel token needed).
# Choose ONE existing-connector overlay after inspecting how cloudflared runs:
#   compose.existing-tunnel.host.yaml -> requires a FREE loopback port on VPS
#   compose.existing-tunnel.docker.yaml -> requires a REVIEWED external network
# Do not add an unrelated cloudflared connector for the ap-pixels tunnel.
FOOTBALLSTUDIO_ORIGIN_PORT=
CLOUDFLARE_EXISTING_NETWORK=
