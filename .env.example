# Copy to .env and generate strong, distinct secret values before Compose start.
# DO NOT commit .env or use empty/example values for a running instance.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=footballstudio
POSTGRES_USER=footballstudio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=0
# Set to 1 only for local loopback HTTP login tests; not for VPS deployment.
DJANGO_LOCAL_HTTP=0
DJANGO_TRUST_PROXY=0
APP_PORT=8000

# NEW remotely-managed tunnel named footballstudio. Never copy token from another project.
# NEVER paste the token into Git, chat, screenshots, issues or logs.
CLOUDFLARE_TUNNEL_TOKEN=
# Start at 0; enable HSTS only after verifying public HTTPS end-to-end.
DJANGO_HSTS_SECONDS=0

# Superseded existing-tunnel alternatives are not used for this deployment.
